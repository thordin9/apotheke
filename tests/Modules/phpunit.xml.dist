<?xml version="1.0" encoding="UTF-8"?>
<!--
  CI4 module tests (CIUnitTestCase). Run from the repository root with the
  root PHPUnit, after `composer install` in both places:
    vendor/bin/phpunit -c ci4/phpunit.xml.dist
  tests/Unit/Ci4ModuleSuiteTest.php runs this suite inside the main PHPUnit run,
  so CI covers it on SQLite and PostgreSQL without a workflow change.
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="../vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="tests/bootstrap.php"
         colors="true"
         cacheDirectory="../.phpunit.cache/ci4"
         failOnWarning="true"
         failOnRisky="true">
    <testsuites>
        <testsuite name="ci4">
            <directory>tests</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>modules/Settings</directory>
            <directory>modules/Layout</directory>
            <directory>modules/Media</directory>
            <directory>modules/Notes</directory>
            <file>modules/Core/Libraries/Text.php</file>
            <file>modules/Core/Libraries/AssetUrl.php</file>
            <file>modules/Core/Cli/WiredCommands.php</file>
            <file>modules/Migrations/BootMigration.php</file>
        </include>
    </source>
    <php>
        <env name="CI_ENVIRONMENT" value="testing" force="true"/>
    </php>
</phpunit>
