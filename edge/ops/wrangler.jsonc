// Apotheke operator console: the Worker `apotheke-ops` serves the console (ops/console/dist, Workers static assets)
// and its API /api/ops/v1 on its own host, behind Cloudflare Access (docs/operator-console.md#console-api).
// Deployed by the deploy-ops job of .github/workflows/deploy-edge.yml, only while the repository variable
// OPS_DEPLOY_ENABLED is "1" (off by default). No routes or custom domains (the host, console.getapotheke.com, is
// attached outside CI once the Access application exists), no workers.dev or preview URLs, no account id, no resource
// ids and no secrets: scripts/ops-deploy-config.mjs adds the D1 id and the three Access vars on the runner only.
// Every request, the console's files included, goes through src/index.ts first, so the Access check also covers the
// static assets.
{
	"$schema": "../node_modules/wrangler/config-schema.json",
	"name": "apotheke-ops",
	"main": "src/index.ts",
	"compatibility_date": "2026-10-29",
	"workers_dev": false,
	"preview_urls": false,
	"observability": { "enabled": true },
	"assets": {
		"directory": "../../ops/console/dist",
		"binding": "ASSETS",
		"run_worker_first": true,
		"not_found_handling": "single-page-application"
	},
	// The control-plane D1 of apotheke-api (edge/storage.jsonc): same binding name and database. The id is added where
	// the Worker is deployed, like apotheke-api's.
	"d1_databases": [{ "binding": "DB", "database_name": "apotheke-api", "migrations_dir": "../migrations/control" }],
	// apotheke-api's named entrypoint Ops (edge/src/index.ts): claimCreate, resetAdmins and listUsers(installation).
	// The only way from this Worker to an installation.
	// No AUTOFILL binding: the lifecycle Workflow runs on apotheke-api, whose own AUTOFILL serves purge.autofill.
	"services": [{ "binding": "OPS", "service": "apotheke-api", "entrypoint": "Ops" }],
	// LIFECYCLE: the lifecycle Workflow (edge/src/lifecycle-workflow.ts), hosted on apotheke-api (edge/storage.jsonc), with its own DB, R2, Durable Objects and AUTOFILL. No R2 or Durable
	// Object binding here. POST /jobs/:id/confirm starts an instance through LIFECYCLE; a job acts only while both
	// Workers' writes flags are "1" (docs/operator-console.md#deploying-the-console).
	"workflows": [{ "name": "apotheke-lifecycle", "binding": "LIFECYCLE", "class_name": "LifecycleWorkflow", "script_name": "apotheke-api" }],
	// Paused: no Cron Trigger (an empty list also removes any cron left on the Worker).
	"triggers": { "crons": [] },
	"vars": {
		// Cloudflare Access: the team domain (<team>.cloudflareaccess.com) and the application's audience tag. Set where
		// the Worker is deployed. While either is empty, every request gets 503 not_configured.
		"ACCESS_TEAM_DOMAIN": "",
		"ACCESS_AUD": "",
		// Comma-separated emails that may use the console (case-insensitive). Set where the Worker is deployed. Empty
		// admits no one: every request gets 503 not_configured.
		"OPS_ALLOWED_EMAILS": "",
		// "1": the console's writes (POST, PUT, PATCH, DELETE) are on in production; anything else makes every write 403
		// writes_disabled. Reported by GET /api/ops/v1/config.
		"OPS_WRITES_ENABLED": "1",
		// "0": provisioning new installations is off (prod). Reported by GET /api/ops/v1/config.
		"OPS_PROVISIONING": "0",
		// Plan limits, as apotheke-api's LIMITS_ENABLED. "0" on prod. Reported by GET /api/ops/v1/config.
		"LIMITS_ENABLED": "0"
	}
}
