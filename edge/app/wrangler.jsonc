// Apotheke front end: the Worker `getapotheke-app` serves frontend/dist (the landing page at / and its static
// pages, and the SPA under /app/) with Workers static assets and a small script for routing and headers.
// No account id, no secrets, and no routes or custom domains: the deploy workflow
// (.github/workflows/deploy-frontend.yml) uses this file as is; the custom domain is attached outside CI.
// The Worker name is checked against an allowlist before every deploy (scripts/cf-worker-guard.mjs).
{
	"$schema": "../node_modules/wrangler/config-schema.json",
	"name": "getapotheke-app",
	"main": "src/index.ts",
	"compatibility_date": "2026-10-29",
	"workers_dev": false,
	"preview_urls": false,
	"assets": {
		"directory": "../../frontend/dist",
		"binding": "ASSETS",
		// Only these paths go through the script (src/index.ts): the SPA under /app/ (its CSP and the fallback to
		// /app/index.html), /config.json and the fonts' cache. Everything else is served straight from the assets
		// with frontend/public/_headers, which owns the landing page's CSP.
		"run_worker_first": ["/app", "/app/*", "/config.json", "/fonts/*"],
		"html_handling": "auto-trailing-slash",
		"not_found_handling": "404-page"
	},
	"vars": {
		// Served as /config.json (no-cache). Non-secret, reviewed here.
		"API_BASE": "https://api.services.getapotheke.com/api/v1"
	}
}
