{
  "name": "apotheke-v4",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Apotheke v4: the app on workerd. Not deployed from this branch (plan §5 S0.2).",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "wrangler dev",
    "test": "vitest run",
    "routes:check": "node scripts/gen-routes.mjs --check",
    "routes": "node scripts/gen-routes.mjs",
    "assets": "node scripts/gen-assets.mjs",
    "assets:check": "node scripts/gen-assets.mjs --check",
    "fixtures:check": "bash scripts/gen-html-fixtures.sh --check && bash scripts/gen-session-fixture.sh --check && bash scripts/gen-claim-fixture.sh --check && bash scripts/gen-security-fixture.sh --check && bash scripts/gen-permissions-fixture.sh --check && bash scripts/gen-api-fixture.sh --check && bash scripts/gen-account-fixture.sh --check",
    "fixtures:capture": "bash scripts/fixtures-capture.sh",
    "typecheck": "tsc --noEmit",
    "lint": "biome check . && depcruise src",
    "format": "biome check --write .",
    "workflows:check": "node scripts/check-workflows-php-free.mjs",
    "ledger:check": "node scripts/check-php-ledger.mjs",
    "skip-list:check": "node scripts/check-visual-skip-list.mjs",
    "citations:check": "node scripts/check-retired-citations.mjs",
    "flip:check": "node scripts/check-visual-flip.mjs",
    "visual-boot:check": "node scripts/check-visual-boot.mjs",
    "cores:check": "node scripts/check-core-dumps.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@cloudflare/vitest-pool-workers": "0.23.0",
    "@cloudflare/workers-types": "5.20261123.1",
    "@swc/core": "1.16.22",
    "dependency-cruiser": "18.9.0",
    "typescript": "7.0.2",
    "vitest": "4.1.12",
    "wrangler": "4.164.0",
    "yaml": "2.9.1"
  },
  "overrides": {
    "workerd": "1.20261117.1"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3"
  }
}
