# Apotheke v4 — self-host environment (plan §11, S0.9).
#
# Copy to `.env`, edit, then `docker compose up -d`. Nothing here is a real secret: the file ships
# with empty secrets on purpose, and `.env` itself is never committed.
#
# These are the app's own variable names (`v4/src/env.ts`, `v4/src/platform/config.ts`,
# `v4/wrangler.jsonc`), which are also the names the PHP app in this repository reads. There is no
# second spelling and no convenience alias: one file, both runtimes.
#
# An empty value is not a value: the loader falls back to the built-in default, exactly as PHP's
# `config_load()` does.

# ---------------------------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------------------------

# `rqlite` (docker-compose.yml) or `sqlite` (docker-compose.sqlite.yml).
#
# Each compose file *pins* this in its own service block, so the file you start decides the backend
# and a stale `.env` cannot point the rqlite stack at a directory. It is set here for the one case
# compose does not cover: running the Worker without compose (e.g. `npx wrangler dev`).
DB_DRIVER=rqlite

# Where the app reaches rqlite. `rqlite` is the compose service name; port 4001 is never published
# to the host (§11 rule 1) — publishing it is a debug step, not the normal install.
RQLITE_URL=http://rqlite:4001

# `username:password` for a node started with `-auth`; empty means the node runs without
# authentication. Both containers read this one variable: the rqlite entrypoint turns it into the
# `-auth` file, and the app turns it into a Basic credential.
#
# Use a URL-safe password (hex is easiest): the rqlite healthcheck puts this value in a URL, and a
# password containing `@`, `/` or `:` would be read as URL syntax rather than as a credential.
# Generate one with: openssl rand -hex 16
#
# This is a secret (§11 rule 4). With it empty, the database is protected only by being on the
# compose network, which is acceptable for a single-host install and not for anything shared.
RQLITE_AUTH=

# rqlite read level (§10 rule 8): `weak` (default) | `strong` | `none`.
# `strong` makes every read wait for the leader; read-after-write is the driver's job, not this.
RQLITE_READ_CONSISTENCY=weak

# ---------------------------------------------------------------------------------------------
# Secrets
# ---------------------------------------------------------------------------------------------

# Password for the `admin` account on a fresh install. At least 8 characters. Leaving it empty is
# allowed only when sign-in is already configured; otherwise the seed phase refuses and `/readyz`
# answers 503 with the reason (it does not seed a password nobody can type).
APP_PASSWORD=

# At-rest key for stored credentials (`enc:v1:`), base64 of 32 bytes. Empty stores them unencrypted.
# Generate one with: openssl rand -base64 32
APP_KEY=

# ---------------------------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------------------------

# Pins "now" to an ISO instant. Empty means the real clock. For tests and fixtures, not for installs.
APOTHEKE_CLOCK=

# `1` marks a hosted installation: sign-in is enforced even before APP_PASSWORD is set. Self-host
# leaves it empty.
APOTHEKE_HOSTED=

# The URL this installation is reached at, used for absolute links and the Host check. No trailing
# slash. `PUBLIC_URL` is the name v3 already ships, so an existing `.env` keeps working.
PUBLIC_URL=http://localhost:9091

# ISO 4217 code, at most 8 code points.
CURRENCY=EUR

# Timezone for display (a PHP/ICU timezone name, e.g. `Europe/Athens`).
TZ=UTC

PAGE_SIZE=60

# Upload limits. `MAX_UPLOAD_MB` is the request limit; the two image bounds are the longest edge, in
# pixels, that the stored full image and its thumbnail are resized to.
MAX_UPLOAD_MB=20
IMAGE_FULL_MAX=1600
IMAGE_THUMB_MAX=480

# How many days ahead an expiry counts as "soon" in the UI. Clamped to 1…3650.
EXPIRY_SOON_DAYS=30
