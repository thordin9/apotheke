# Copy to .env next to docker-compose.yml. .env is git-ignored. Never commit a real key.
#
# 32-byte key, standard base64. Generate one with:
#   php -r 'echo base64_encode(random_bytes(32)), PHP_EOL;'
# or, once Apotheke is installed:
#   php bin/settings.php key generate
# Recommended for Docker. Leave empty to keep stored secrets unencrypted.
APP_KEY=

# Optional file outside the data directory and outside backup paths.
# Ignored when APP_KEY is set. A path inside the data directory is refused.
# APP_KEY_FILE=

# Cookie consent: required (default; no cookie until the user accepts the notice) or off (cookies as before 3.3).
# Any other value counts as required. See docs/deployment-and-operations.md "Cookie consent".
# COOKIE_CONSENT=required
