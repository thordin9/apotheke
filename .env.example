# Copy to .env next to docker-compose.yml. .env is git-ignored. Never commit a real key.
#
# 32-byte key, standard base64. Generate one with:
#   php -r 'echo base64_encode(random_bytes(32)), PHP_EOL;'
# or, once Apotheke is installed:
#   php bin/settings.php key generate
# Recommended for Docker. Leave empty to keep stored secrets unencrypted.
APP_KEY=

# Optional file outside the data directory and outside backup paths.
# Ignored when APP_KEY is set. A path inside the data directory is refused.
# APP_KEY_FILE=

# Docker image: Dockerfile (nginx + php-fpm, default) or Dockerfile.frankenphp (FrankenPHP).
# Rebuild after changing it: docker compose up -d --build
# APOTHEKE_DOCKERFILE=Dockerfile.frankenphp
# APOTHEKE_IMAGE_TAG=latest
# FrankenPHP image only: PHP threads (1-64, default 2).
# FRANKENPHP_NUM_THREADS=2

# Cookie consent: required (default; no cookie until the user accepts the notice) or off (cookies as before 3.4).
# Any other value counts as required. See docs/deployment-and-operations.md "Cookie consent".
# COOKIE_CONSENT=required
# Parent domain for the consent cookie (empty: host-only). Hosted installs: getapotheke.com. Used only on that
# host or below it; IPs, single labels, ports, paths and wildcards are ignored. Never set on the session cookie.
# COOKIE_DOMAIN=
