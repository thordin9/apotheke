# Apotheke on FrankenPHP: Caddy + PHP in one process (Dockerfile.frankenphp). The same rules as the nginx image
# (docker/nginx.conf); the differences are listed in docs/deployment-and-operations.md (FrankenPHP image).
#
# Two servers in one process:
#  - the public one on :$PORT applies every rule below (caps, sign-in checks, static files), then hands the request
#    to the PHP server through a reverse proxy that first reads small bodies completely (request_buffers);
#  - the PHP server listens only on a unix socket under /run and runs PHP.
# Why (M-1420): FrankenPHP streams request bodies into PHP, so a slow upload holds one of the few PHP threads for as
# long as the client takes. Now a body of up to 64 KiB (everything a signed-out client may send: the sign-in form,
# POST /api/v1/session) is read by Caddy before PHP sees the request, and a larger body or one without a length is
# only read after the app said the client is signed in (/upload/check). Slow anonymous clients hold a goroutine and
# at most 64 KiB of memory each, never a PHP thread.
#
# Request bodies (MiB, 1 MiB = 1,048,576 bytes): 22 MiB on every route; 520 MiB only on POST /backup/restore (that
# exact path), and only after the app said yes to /backup/restore/check (signed in with the Backup permission).
# PHP's own limits (php-frankenphp.ini) are the restore ones, so these caps are what keeps every other route at
# 22 MiB (scripts/docker-auth-checks.sh tests it).
# Every hop to the PHP server (the main reverse_proxy and both forward_auth checks) carries the same request headers
# (M-1450): the client address in X-Apotheke-Peer-* (set here, never from the client), and the client's own
# X-Forwarded-For, -Proto and -Host unchanged (the app decides whom to trust, with trust_proxy and TRUSTED_PROXIES).
# Without them Caddy would put its own values (X-Forwarded-Proto: http) on the sign-in checks, and behind an HTTPS
# proxy the app would not see the __Host- session cookie there. The Host header is passed through as is.
(php_hop) {
	header_up -Via
	header_up X-Apotheke-Peer-Addr {remote_host}
	header_up X-Apotheke-Peer-Port {remote_port}
	header_up X-Forwarded-For {http.request.header.X-Forwarded-For}
	header_up X-Forwarded-Proto {http.request.header.X-Forwarded-Proto}
	header_up X-Forwarded-Host {http.request.header.X-Forwarded-Host}
}

{
	admin off
	auto_https off
	persist_config off
	skip_install_trust
	frankenphp {
		# PHP threads = requests served at once. The entrypoint checks the value (1-64, default 2).
		num_threads {$FRANKENPHP_NUM_THREADS:2}
		max_threads {$FRANKENPHP_NUM_THREADS:2}
	}
	servers {
		# HTTP/1.1 only, on both servers, as nginx (M-1454): no cleartext HTTP/2 (h2c), whose bodies have no
		# Transfer-Encoding, so a length-less GET body could not be told apart (411, the sign-in check) from no body.
		protocols h1
		# nginx: client_header_timeout, keepalive_timeout 65s, client_body_timeout (300s for a restore upload)
		timeouts {
			read_header 10s
			read_body 300s
			idle 65s
		}
	}
	log {
		output stderr
		level WARN
	}
}

:{$PORT:9091} {
	root * /var/www/app/public
	# Access log on stdout. Never the secrets a request carries (L-1422): Cookie, Authorization, the CSRF token and
	# the edge proxy's shared secret are dropped from the logged headers.
	log {
		output stdout
		format filter {
			wrap json
			fields {
				request>headers>Cookie delete
				request>headers>Authorization delete
				request>headers>Proxy-Authorization delete
				request>headers>X-Csrf-Token delete
				request>headers>X-Apotheke-Proxy delete
				resp_headers>Set-Cookie delete
			}
		}
	}

	# nginx: server_tokens off (Caddy has no version in Server, but drop the name too); httpoxy (HTTP_PROXY "")
	header -Server
	header -Via
	request_header -Proxy

	# nginx: gzip on, min length 512, the same types
	encode {
		gzip 5
		minimum_length 512
		match {
			header Content-Type text/css*
			header Content-Type application/javascript*
			header Content-Type text/javascript*
			header Content-Type application/json*
			header Content-Type image/svg+xml*
			header Content-Type text/csv*
			header Content-Type text/plain*
			header Content-Type text/html*
			header Content-Type application/manifest+json*
		}
	}

	# One route, so the rules apply in the order written (Caddy otherwise sorts directives by type)
	route {
		# nginx: only GET/HEAD/POST/... reach the app; TRACE gets 405
		@trace method TRACE
		respond @trace 405

		# Camera originals are not a URL, in any spelling; dotfiles and private dirs are never served or run
		@originals path_regexp originals (?i)^/originals(/|$)
		respond @originals 404
		@dot path_regexp dot /\.
		respond @dot 404
		@private path_regexp private ^/(src|data|bin|migrations|docker|tests|vendor|config\.php)(/|$)
		respond @private 404
		# Only the front controller runs PHP; any other *.php is a 404, never executed
		@otherphp {
			path_regexp otherphp \.(php|phtml|phar)$
			not path /index.php
		}
		respond @otherphp 404

		# Static assets: long-lived cache, nosniff, never the app (nginx: location ^~ /assets/ ... try_files $uri =404)
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		header @assets X-Content-Type-Options nosniff
		@assetfile {
			path /assets/*
			file {path}
		}
		file_server @assetfile
		respond @assets 404

		# Backup restore: up to 520 MiB, only for POST on exactly /backup/restore (case-sensitive, no trailing slash;
		# N-1425), and only after the app said yes to /backup/restore/check. forward_auth asks the app (a body-less
		# GET, same Host and cookies) before the body is read; any non-2xx answer (401, 403, 421 with the app's text,
		# 404) is returned as is (nginx: auth_request).
		@restore {
			method POST
			path_regexp restore ^/backup/restore$
		}
		@restoretoolarge {
			method POST
			path_regexp restore ^/backup/restore$
			expression `{http.request.header.Content-Length}.matches("^[0-9]{1,15}$") && int({http.request.header.Content-Length}) > 545259520`
		}
		request_body @restore {
			max_size 520MiB
		}
		forward_auth @restore unix//run/apotheke-caddy/php.sock {
			uri /backup/restore/check
			import php_hop
		}
		# over 520 MiB: refused only after the check, so a signed-out client learns nothing but 401 (nginx checks the
		# declared size first and answers 413)
		respond @restoretoolarge 413

		# Every other request (any other path or method): 22 MiB (nginx: client_max_body_size 22m). A declared length
		# over the cap is a 413 before anything is read; a body without a length (chunked) is a 413 at the cap.
		@toolarge {
			not {
				method POST
				path_regexp restore ^/backup/restore$
			}
			expression `{http.request.header.Content-Length}.matches("^[0-9]{1,15}$") && int({http.request.header.Content-Length}) > 23068672`
		}
		respond @toolarge 413
		@notrestore {
			not {
				method POST
				path_regexp restore ^/backup/restore$
			}
		}
		request_body @notrestore {
			max_size 22MiB
		}
		# GET, HEAD and OPTIONS never carry a body the app reads: one without a declared length (chunked) is a 411
		# before PHP sees it, on any route and whether signed in or not (M-1451); Go's server may still read and drop
		# up to 256 KiB of that body in Caddy to keep the connection open. The header matcher sees
		# Transfer-Encoding (Go moves it out of the header map; the {http.request.header.*} placeholders do not).
		@chunkednobody {
			method GET HEAD OPTIONS
			header Transfer-Encoding *
		}
		respond @chunkednobody 411
		# A body over 64 KiB (any method), or one without a declared length (chunked: no Content-Length on a method other
		# than GET, HEAD or OPTIONS, which got their 411 above), only after the app said the client is signed in (or
		# sign-in is off): 204 from /upload/check, else its 401 as is. Signed-out clients never need more (M-1420).
		@largebody {
			not {
				method POST
				path_regexp restore ^/backup/restore$
			}
			expression `({http.request.header.Content-Length}.matches("^[0-9]+$") && ({http.request.header.Content-Length}.size() > 5 || int({http.request.header.Content-Length}) > 65536)) || ({http.request.header.Content-Length} == "" && !({http.request.method} in ["GET", "HEAD", "OPTIONS"]))`
		}
		forward_auth @largebody unix//run/apotheke-caddy/php.sock {
			uri /upload/check
			import php_hop
		}

		# PHP, through the socket. Up to 64 KiB of the body is read here first, so a slow small body never reaches a
		# PHP thread; the request headers are the php_hop ones (see the top of this file).
		reverse_proxy unix//run/apotheke-caddy/php.sock {
			request_buffers 64KiB
			flush_interval -1
			header_down -Via
			import php_hop
		}
	}

	# Errors raised by Caddy itself (413, 404 of a missing asset): a bare status, no Server header
	handle_errors {
		header -Server
		respond "{err.status_code} {err.status_text}" {err.status_code}
	}
}

# The PHP server: only on the unix socket (no TCP port, nothing else can reach it), no access log of its own.
http:// {
	bind unix//run/apotheke-caddy/php.sock|0660
	root * /var/www/app/public
	header -Server
	# Existing files are served, everything else goes to the front controller (nginx: try_files $uri @app). PHP sees
	# the public server's client address and port, as with nginx's fastcgi_params.
	php_server {
		try_files {path} index.php
		env REMOTE_ADDR {http.request.header.X-Apotheke-Peer-Addr}
		env REMOTE_PORT {http.request.header.X-Apotheke-Peer-Port}
		env SERVER_PORT {$PORT:9091}
	}
}
