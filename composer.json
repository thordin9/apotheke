{
    "name": "thordin9/apotheke-ci4",
    "description": "Apotheke on CodeIgniter 4",
    "license": "MIT",
    "type": "project",
    "require": {
        "php": "^8.4",
        "ext-intl": "*",
        "ext-mbstring": "*",
        "ext-sqlite3": "*",
        "codeigniter4/framework": "4.7.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Config\\": "app/Config/",
            "Apotheke\\": "modules/"
        },
        "exclude-from-classmap": [
            "**/Database/Migrations/**"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "platform": {
            "php": "8.4.26"
        }
    }
}
