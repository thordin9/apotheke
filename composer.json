{
    "name": "thordin9/apotheke",
    "description": "Apotheke (ἀποθήκη): a fast, mobile-first catalog for your stuff on CodeIgniter 4 (SQLite or PostgreSQL)",
    "license": "MIT",
    "type": "project",
    "require": {
        "php": "^8.4",
        "ext-intl": "*",
        "ext-mbstring": "*",
        "ext-sqlite3": "*",
        "codeigniter4/framework": "4.7.5"
    },
    "require-dev": {
        "deptrac/deptrac": "^2.0",
        "league/openapi-psr7-validator": "0.24",
        "nyholm/psr7": "1.8.2",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpcov": "^10.0",
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Config\\": "app/Config/",
            "Apotheke\\": "modules/"
        },
        "exclude-from-classmap": [
            "**/Database/Migrations/**"
        ]
    },
    "autoload-dev": {
        "classmap": [
            "tests/Unit/"
        ],
        "psr-4": {
            "Apotheke\\Tools\\PhpStan\\": "tools/PhpStan/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:unit": "phpunit --testsuite unit"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "platform": {
            "php": "8.4.26"
        }
    }
}
