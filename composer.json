{
    "name": "thordin9/apotheke",
    "description": "Apotheke (ἀποθήκη): a fast, mobile-first PHP catalog for your stuff (SQLite or PostgreSQL)",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.2",
        "ext-gd": "*",
        "ext-mbstring": "*",
        "ext-pdo": "*"
    },
    "suggest": {
        "ext-pdo_sqlite": "SQLite storage (default)",
        "ext-pdo_pgsql": "PostgreSQL storage",
        "ext-exif": "Honour photo orientation"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload-dev": {
        "classmap": ["tests/Unit/", "tests/Integration/"]
    },
    "scripts": {
        "test": "phpunit",
        "test:unit": "phpunit --testsuite unit",
        "test:integration": "phpunit --testsuite integration"
    },
    "config": {
        "sort-packages": true,
        "platform": { "php": "8.2.0" }
    }
}
