parameters:
    level: 6
    dynamicConstantNames:
        - ENVIRONMENT
        - CI_DEBUG
        - APPPATH
        - ROOTPATH
        - FCPATH
        - APP_NAMESPACE
    paths:
        - ci4/modules
        - ci4/app/Config/Services.php
        - ci4/app/Config/Filters.php
        - ci4/app/Config/Routes.php
        - ci4/app/Config/Events.php
        - ci4/app/Config/Exceptions.php
        - ci4/app/Config/App.php
        - ci4/public
    bootstrapFiles:
        - ci4/tools/PhpStan/bootstrap.php
rules:
    - Apotheke\Tools\PhpStan\NoServiceRule
