parameters:
    level: 6
    dynamicConstantNames:
        - ENVIRONMENT
        - CI_DEBUG
        - APPPATH
        - ROOTPATH
        - FCPATH
        - APP_NAMESPACE
    paths:
        - modules
        - app/Config/Services.php
        - app/Config/Filters.php
        - app/Config/Routes.php
        - app/Config/Events.php
        - app/Config/Exceptions.php
        - app/Config/App.php
        - public
    excludePaths:
        # The shim is the untyped legacy function bodies. Golden tests cover it.
        - modules/Migrations/LegacyFunctions.php
    ignoreErrors:
        # The PHP version guard is for an older PHP than composer.json allows, which PHPStan assumes.
        -
            identifier: if.alwaysFalse
            path: public/index.php
    bootstrapFiles:
        - tools/PhpStan/bootstrap.php
rules:
    - Apotheke\Tools\PhpStan\NoServiceRule
