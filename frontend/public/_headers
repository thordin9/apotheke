# Cloudflare static-asset headers (Workers _headers).
# Matching rules are inherited and joined with a comma. A later rule does not
# replace an earlier one by being more specific. To replace a header, detach
# it with `! Header-Name` and set it again in the same rule. Rules are listed
# broad-first so the detach in a narrower rule runs after the broad one.
#
# Chosen mechanism: `!` detach (not path ordering alone). DevOps mirrors the
# /app/* CSP in the Worker, because _headers is not applied to Worker responses.

/*
  Strict-Transport-Security: max-age=31536000
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=(), accelerometer=(), gyroscope=(), magnetometer=(), payment=(), usb=(), bluetooth=(), serial=(), hid=(), midi=(), display-capture=(), browsing-topics=()
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; manifest-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; object-src 'none'
  Cache-Control: no-cache

# That no-cache covers HTML, including /404.html. A second /404.html rule that
# only set no-cache again did not change the result.

# Hashed Vite output only (name-hash.js and name-hash.css). A missing file such
# as /assets/missing.js does not match, so it keeps no-cache from /*. Fonts stay
# unhashed at /fonts/ (the Worker caches those for a day). Brand, mascot, shots
# and the icon sprite keep the one-day rules below.
/assets/*-*.js
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

/assets/*-*.css
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

# Unhashed files copied from public/. Detach Cache-Control so a hashed-name
# rule above is not comma-joined onto these files.
/assets/brand/*
  ! Cache-Control
  Cache-Control: public, max-age=86400

/assets/mascot/*
  ! Cache-Control
  Cache-Control: public, max-age=86400

/assets/shots/*
  ! Cache-Control
  Cache-Control: public, max-age=86400

/assets/icons.svg
  ! Cache-Control
  Cache-Control: public, max-age=86400

# SPA. Detach the landing CSP first so the two policies are not both applied.
/app/*
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' blob: data: https://api.services.getapotheke.com; connect-src 'self' https://api.services.getapotheke.com; font-src 'self'; manifest-src 'self'; worker-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; object-src 'none'
